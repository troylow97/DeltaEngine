%Entry:

entry 
Clip/IdleSpritesheet

%Parameters:

param
Speed 0 0

param
IsJumping 0 0

param
Punch 0 0

param
IsIdle 0 0

param
IsRunning 0 0

param
Ranged 0 0

param
PlayerVelocityY 0 0

param
NewParam 0 0

param
NewParam0 0 0

param
NewParam1 0 0

%EditorPositions:

pos
Entry 3 4

pos
Exit 351 360

pos
Clip/IdleSpritesheet 31 133

pos
Clip/RunningSpritesheet 439 145

pos
Clip/RangeAttackSpritesheet -54 299

pos
Clip/3-PunchSpritesheet 380 271

pos
Clip/LeapingSpritesheet 449 64

pos
Clip/FallingSpritesheet 157 20

%Transitions:

transition 
start Clip/IdleSpritesheet
end Clip/RunningSpritesheet
condition IsRunning ? 1
endTransition

transition 
start Clip/RunningSpritesheet
end Clip/IdleSpritesheet
condition IsRunning ? 0
endTransition

transition 
start Clip/IdleSpritesheet
end Clip/RangeAttackSpritesheet
condition Ranged ? 1
endTransition

transition 
start Clip/RangeAttackSpritesheet
end Clip/IdleSpritesheet
condition Ranged ? 0
endTransition

transition 
start Clip/IdleSpritesheet
end Clip/3-PunchSpritesheet
condition Punch ? 1
endTransition

transition 
start Clip/3-PunchSpritesheet
end Clip/IdleSpritesheet
condition Punch ? 0
condition Speed ? 0
endTransition

transition 
start Clip/IdleSpritesheet
end Clip/LeapingSpritesheet
condition PlayerVelocityY > 0
endTransition

transition 
start Clip/LeapingSpritesheet
end Clip/FallingSpritesheet
condition PlayerVelocityY < 0
endTransition

transition 
start Clip/FallingSpritesheet
end Clip/IdleSpritesheet
condition PlayerVelocityY = 0
endTransition

%endfile
