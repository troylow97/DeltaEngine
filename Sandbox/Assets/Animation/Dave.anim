entry Clip/IdleSpritesheet

%Parameters:

param
Speed 0 0

param
IsJumping 0 0

param
Punch 0 0

param
IsIdle 0 0

param
IsRunning 0 0

param
Ranged 0 0

param
PlayerVelocityY 0 0

%EditorPositions:

pos
Entry 3 4

pos
Exit 543 258

pos
Clip/IdleSpritesheet -32 112

pos
Clip/RunningSpritesheet 301 200

pos
Clip/RangeAttackSpritesheet 70 403

pos
Clip/3-PunchSpritesheet -26 284

pos
Clip/LeapingSpritesheet 508 18

pos
Clip/FallingSpritesheet 186 11

pos
Clip/StretchSpritesheet 374 466

%Transitions:

transition 
start Clip/IdleSpritesheet
end Clip/RunningSpritesheet
condition IsRunning ? 1
endTransition

transition 
start Clip/RunningSpritesheet
end Clip/IdleSpritesheet
condition IsRunning ? 0
endTransition

transition 
start Clip/IdleSpritesheet
end Clip/RangeAttackSpritesheet
condition Ranged ? 1
endTransition

transition 
start Clip/RangeAttackSpritesheet
end Clip/IdleSpritesheet
condition Ranged ? 0
endTransition

transition 
start Clip/IdleSpritesheet
end Clip/3-PunchSpritesheet
condition Punch ? 1
endTransition

transition 
start Clip/3-PunchSpritesheet
end Clip/IdleSpritesheet
condition Punch ? 0
condition Speed ? 0
endTransition

transition 
start Clip/IdleSpritesheet
end Clip/LeapingSpritesheet
condition PlayerVelocityY > 0
endTransition

transition 
start Clip/LeapingSpritesheet
end Clip/FallingSpritesheet
condition PlayerVelocityY < 0
endTransition

transition 
start Clip/FallingSpritesheet
end Clip/IdleSpritesheet
condition PlayerVelocityY = 0
endTransition

transition 
start Clip/IdleSpritesheet
end Clip/StretchSpritesheet
condition IsIdle > 8
endTransition

transition 
start Clip/StretchSpritesheet
end Clip/RunningSpritesheet
condition IsRunning ? 1
endTransition

transition 
start Clip/StretchSpritesheet
end Clip/IdleSpritesheet
condition IsIdle < 8
endTransition

transition 
start Clip/RunningSpritesheet
end Clip/RangeAttackSpritesheet
endTransition

transition 
start Clip/RunningSpritesheet
end Clip/3-PunchSpritesheet
condition Speed ? 0
endTransition

transition 
start Clip/StretchSpritesheet
end Exit
endTransition

transition 
start Clip/StretchSpritesheet
end Clip/LeapingSpritesheet
endTransition

transition 
start Clip/LeapingSpritesheet
end Clip/RangeAttackSpritesheet
endTransition

%endfile
